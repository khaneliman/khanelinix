+/// Sound similarity a selection needs to count as covering part of the
+/// transcript.
+const MIN_PLACEMENT_SOUND: f64 = 0.6;
+
+/// A corrected selection matched to the transcript text it replaces.
+struct Placement {
+    spoken: String,
+    copied: String,
+    sound: f64,
+    letters: f64,
+    words: usize,
+}
+
+/// Find the transcript words a corrected selection covers. Misheard text
+/// sounds like its correction, so the best window is the one whose sound key
+/// matches the selection's most closely, with letters and then fewer words
+/// as tiebreaks. That places a lone fixed word, a fix at the edge of the
+/// selection, or the whole corrected dictation. A selection much longer than
+/// the transcript is searched the other way, for the part that covers it.
+fn place_selection(transcript: &str, corrected: &str) -> Option<Placement> {
+    let spoken: Vec<&str> = transcript.split_whitespace().collect();
+    let copied: Vec<&str> = corrected.split_whitespace().collect();
+    let (n, m) = (spoken.len(), copied.len());
+    if n == 0 || m == 0 {
+        return None;
+    }
+    // One misheard phrase of up to MAX_LEARNED_WORDS may differ in length
+    // from its correction.
+    let windows = |words: &[&str], target: usize| -> Vec<String> {
+        let shortest = target.saturating_sub(MAX_LEARNED_WORDS).max(1);
+        let longest = (target + MAX_LEARNED_WORDS).min(words.len());
+        (shortest..=longest)
+            .flat_map(|len| words.windows(len).map(|w| w.join(" ")).collect::<Vec<_>>())
+            .collect()
+    };
+    let candidates: Vec<(String, String)> = if m <= n + MAX_LEARNED_WORDS {
+        windows(&spoken, m)
+            .into_iter()
+            .map(|w| (w, copied.join(" ")))
+            .collect()
+    } else {
+        windows(&copied, n)
+            .into_iter()
+            .map(|w| (spoken.join(" "), w))
+            .collect()
+    };
+
+    let mut best: Option<Placement> = None;
+    for (spoken, copied) in candidates {
+        let placement = Placement {
+            sound: sound_similarity(&spoken, &copied),
+            letters: sequence_ratio(letter_chars(&spoken), letter_chars(&copied)),
+            words: spoken.split_whitespace().count() + copied.split_whitespace().count(),
+            spoken,
+            copied,
+        };
+        let rank = |p: &Placement| (p.sound, p.letters, std::cmp::Reverse(p.words));
+        if best.as_ref().is_none_or(|top| rank(&placement) > rank(top)) {
+            best = Some(placement);
+        }
+    }
+    best.filter(|p| p.sound >= MIN_PLACEMENT_SOUND && p.letters >= MIN_PAIR_SIMILARITY)
+}
+
+/// How well a candidate selection lines up with the transcript, for picking
+/// between the primary selection and the clipboard.
+pub fn selection_score(transcript: &str, corrected: &str) -> f64 {
+    place_selection(transcript, corrected).map_or(0.0, |p| p.sound)
+}
+
+/// Compare a corrected selection with the transcript text it covers.
+pub fn diff_selection(transcript: &str, corrected: &str) -> LearnDiff {
+    match place_selection(transcript, corrected.trim()) {
+        Some(p) if p.spoken.trim() == p.copied.trim() => LearnDiff::Identical,
+        // Placement already required the selection to sound and read like
+        // the spoken text, case-insensitively, so the raw character check in
+        // diff_replacements would only reject case fixes and short forms.
+        Some(p) => pairs_between(&p.spoken, &p.copied),
+        None => LearnDiff::Unaligned,
+    }
+}
