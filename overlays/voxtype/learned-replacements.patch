+    };
+    match toml::from_str::<LearnedReplacements>(&content) {
+        Ok(file) => file.replacements.into_iter().collect(),
+        Err(e) => {
+            tracing::warn!("Ignoring unreadable {}: {}", path.display(), e);
+            HashMap::new()
+        }
+    }
+}
+
+/// Merge pairs into the learned replacements file, overwriting entries for
+/// the same spoken form. Returns the file written.
+pub fn merge_learned_replacements(pairs: &[(String, String)]) -> std::io::Result<PathBuf> {
+    let path = learned_replacements_path();
+    merge_learned_replacements_at(&path, pairs)?;
+    Ok(path)
+}
+
+fn merge_learned_replacements_at(path: &Path, pairs: &[(String, String)]) -> std::io::Result<()> {
+    let mut file = std::fs::read_to_string(path)
+        .ok()
+        .and_then(|content| toml::from_str::<LearnedReplacements>(&content).ok())
+        .unwrap_or_default();
+    for (from, to) in pairs {
+        file.replacements.insert(from.to_lowercase(), to.clone());
+    }
+    let content = toml::to_string(&file).map_err(std::io::Error::other)?;
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent)?;
+    }
+    let tmp = path.with_extension("toml.tmp");
+    std::fs::write(&tmp, content)?;
+    std::fs::rename(tmp, path)
+}
+
+/// Trim punctuation a whitespace diff leaves on phrase edges, so
+/// `"hyperland,"` learns as `"hyperland"`: replacements match on word
+/// boundaries, which a trailing comma or period never satisfies. Edge
+/// punctuation on the spoken side is dropped; the same punctuation on the
+/// corrected side is dropped with it. Returns `None` when nothing remains
+/// to replace, or when the spoken side is one short word.
+pub fn normalize_learned_pair(from: &str, to: &str) -> Option<(String, String)> {
+    let is_edge = |c: char| !c.is_alphanumeric();
+    let key = from.trim_matches(is_edge);
+    // Nothing spoken, or only punctuation around the same words changed.
+    if key.is_empty() || to.trim_matches(is_edge) == key {
+        return None;
+    }
+    // Replacing a word such as "to" in every dictation is never a fix.
+    if !key.contains(char::is_whitespace) && key.chars().filter(|c| c.is_alphanumeric()).count() <= 3
+    {
+        return None;
+    }
+    let lead = &from[..from.len() - from.trim_start_matches(is_edge).len()];
+    let trail = &from[from.trim_end_matches(is_edge).len()..];
+    let value = to.strip_prefix(lead).unwrap_or(to);
+    let value = value.strip_suffix(trail).unwrap_or(value);
+    // Sentence punctuation belongs to the surrounding text, not the term.
+    let value = value.trim_end_matches([',', ';', ':', '.', '!', '?']).trim();
+    if value.is_empty() || value == key {
+        return None;
+    }
+    Some((key.to_string(), value.to_string()))
+}
