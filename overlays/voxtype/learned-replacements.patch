+/// Longest phrase, in words, learned from one replace block. Longer blocks
+/// are rewrites of the sentence rather than a misheard term.
+const MAX_LEARNED_WORDS: usize = 4;
+
+/// Letter similarity a learned pair needs. Misheard terms sound alike and
+/// share most letters ("hyper end" and "Hyprland"); reworded text does not
+/// ("ship" and "wait until").
+const MIN_PAIR_SIMILARITY: f64 = 0.4;
+
+fn looks_misheard(old: &str, new: &str) -> bool {
+    let letters = |s: &str| -> Vec<char> {
+        s.chars()
+            .filter(|c| c.is_alphanumeric())
+            .flat_map(char::to_lowercase)
+            .collect()
+    };
+    sequence_ratio(letters(old), letters(new)) >= MIN_PAIR_SIMILARITY
+}
