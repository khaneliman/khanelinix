+
+/// Classify a selection [`diff_selection`] could not place, so the message
+/// names the actual fix.
+pub fn unaligned_reason(transcript: &str, corrected: &str) -> UnalignedReason {
+    let spoken: HashSet<String> = transcript
+        .split_whitespace()
+        .map(anchor_token)
+        .filter(|w| !w.is_empty())
+        .collect();
+    let selected: Vec<String> = corrected
+        .split_whitespace()
+        .map(anchor_token)
+        .filter(|w| !w.is_empty())
+        .collect();
+    let shared = selected.iter().filter(|w| spoken.contains(*w)).count();
+    if !selected.is_empty() && shared * 2 >= selected.len() {
+        return UnalignedReason::NeedsContext;
+    }
+    // A lone corrected phrase shares no words but sounds like part of the
+    // dictation.
+    if (1..=MAX_LEARNED_WORDS).contains(&selected.len()) {
+        let words: Vec<&str> = transcript.split_whitespace().collect();
+        for n in 1..=MAX_LEARNED_WORDS.min(words.len()) {
+            if words
+                .windows(n)
+                .any(|window| looks_misheard(&window.join(" "), corrected))
+            {
+                return UnalignedReason::NeedsContext;
+            }
+        }
+    }
+    UnalignedReason::Unrelated
+}
+
+/// How well a candidate selection lines up with the transcript, for picking
+/// between the primary selection and the clipboard.
+pub fn selection_score(transcript: &str, corrected: &str) -> f64 {
+    aligned_span(transcript, corrected).map_or(0.0, |(_, score)| score)
+}
+
+/// Compare a corrected selection with the transcript span it covers.
+pub fn diff_selection(transcript: &str, corrected: &str) -> LearnDiff {
+    match aligned_span(transcript, corrected.trim()) {
+        Some((span, _)) => diff_replacements(&span, corrected),
+        None => LearnDiff::Unaligned,
+    }
+}
