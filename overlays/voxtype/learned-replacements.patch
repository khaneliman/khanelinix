+/// Word as it counts for anchoring: lowercase, without edge punctuation.
+fn anchor_token(word: &str) -> String {
+    word.trim_matches(|c: char| !c.is_alphanumeric()).to_lowercase()
+}
+
+/// Locate the transcript span a corrected selection covers, so the user can
+/// select a fix with an unchanged word on each side instead of the whole
+/// dictation. The selection's first and last words anchor the span; a
+/// selection whose edge word was changed only places as the whole
+/// transcript. Returns the span and its word-level similarity.
+pub fn aligned_span(transcript: &str, corrected: &str) -> Option<(String, f64)> {
+    let words: Vec<&str> = transcript.split_whitespace().collect();
+    let selected: Vec<String> = corrected.split_whitespace().map(anchor_token).collect();
+    if words.is_empty() || selected.is_empty() {
+        return None;
+    }
+    let spoken: Vec<String> = words.iter().map(|w| anchor_token(w)).collect();
+    let (first, last) = (&selected[0], &selected[selected.len() - 1]);
+    let starts = (0..words.len()).filter(|&i| &spoken[i] == first);
+    let mut spans: Vec<(usize, usize)> = starts
+        .flat_map(|i| {
+            (i..words.len())
+                .filter(|&j| &spoken[j] == last)
+                .map(move |j| (i, j))
+                .collect::<Vec<_>>()
+        })
+        .collect();
+    spans.push((0, words.len() - 1));
+
+    let mut best: Option<(usize, usize, f64)> = None;
+    for (i, j) in spans {
+        // A fix changes at most MAX_LEARNED_WORDS words per phrase.
+        let len = j - i + 1;
+        if len + MAX_LEARNED_WORDS < selected.len() || len > selected.len() + MAX_LEARNED_WORDS {
+            continue;
+        }
+        let score = sequence_ratio(spoken[i..=j].iter(), selected.iter());
+        if best.is_none_or(|(_, _, top)| score > top) {
+            best = Some((i, j, score));
+        }
+    }
+    best.map(|(i, j, score)| (words[i..=j].join(" "), score))
+}
