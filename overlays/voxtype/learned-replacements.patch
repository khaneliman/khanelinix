+    #[test]
+    fn normalize_learned_pair_trims_edge_punctuation() {
+        let pair = |from: &str, to: &str| normalize_learned_pair(from, to);
+        assert_eq!(pair("hyperland,", "Hyprland,"), Some(("hyperland".into(), "Hyprland".into())));
+        assert_eq!(
+            pair("omaar gielen nu,", "Omarchy menu"),
+            Some(("omaar gielen nu".into(), "Omarchy menu".into()))
+        );
+        assert_eq!(pair("(foo)", "(bar)"), Some(("foo".into(), "bar".into())));
+        assert_eq!(pair(",", "and"), None);
+        assert_eq!(pair("same.", "same."), None);
+        // Punctuation-only edits teach nothing.
+        assert_eq!(pair("check", "check,"), None);
+        // Trailing sentence punctuation stays with the sentence...
+        assert_eq!(pair("cube cuddle", "kubectl,"), Some(("cube cuddle".into(), "kubectl".into())));
+        // ...while punctuation inside a term survives.
+        assert_eq!(pair("dot net", ".NET"), Some(("dot net".into(), ".NET".into())));
+    }
