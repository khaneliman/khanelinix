+/// Soundex consonant class of a letter; vowels, h, w, and y have none.
+fn sound_class(c: char) -> Option<u8> {
+    match c.to_ascii_lowercase() {
+        'b' | 'f' | 'p' | 'v' => Some(1),
+        'c' | 'g' | 'j' | 'k' | 'q' | 's' | 'x' | 'z' => Some(2),
+        'd' | 't' => Some(3),
+        'l' => Some(4),
+        'm' | 'n' => Some(5),
+        'r' => Some(6),
+        _ => None,
+    }
+}
+
+/// How a phrase sounds, ignoring spelling and word breaks: its consonant
+/// classes with repeats collapsed, so "Nick's packages" and "nixpkgs" share
+/// one key.
+fn sound_key(text: &str) -> Vec<u8> {
+    let mut key: Vec<u8> = Vec::new();
+    for class in text.chars().filter_map(sound_class) {
+        if key.last() != Some(&class) {
+            key.push(class);
+        }
+    }
+    key
+}
