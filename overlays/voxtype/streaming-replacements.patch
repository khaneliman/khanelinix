+/// Byte offsets where a word begins: a word character after a non-word
+/// character or at the start, matching the `\b` that replacements use.
+fn word_starts(text: &str) -> Vec<usize> {
+    let mut starts = Vec::new();
+    let mut prev_word = false;
+    for (i, c) in text.char_indices() {
+        let word = c.is_alphanumeric() || c == '_';
+        if word && !prev_word {
+            starts.push(i);
+        }
+        prev_word = word;
+    }
+    starts
