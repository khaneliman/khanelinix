+    /// Whether any custom replacements are configured.
+    pub fn has_replacements(&self) -> bool {
+        !self.replacements.is_empty()
+    }
+
+    /// Byte offset from which the untyped tail of a streaming transcript
+    /// must be held back, because a replacement could still start there
+    /// once more text arrives. Everything before it is safe to type now;
+    /// `text.len()` means nothing needs holding.
+    pub fn replacement_hold_start(&self, text: &str) -> usize {
+        let max_words = self
+            .replacements
+            .keys()
+            .map(|key| key.split_whitespace().count())
+            .max()
+            .unwrap_or(0);
+        if max_words == 0 {
+            return text.len();
+        }
+        let starts = word_starts(text);
+        // Punctuation splits words more finely than the keys' whitespace
+        // does, so look a little further back than the longest key.
+        let window = &starts[starts.len().saturating_sub(max_words * 2)..];
+        for &start in window {
+            let tail = text[start..].to_lowercase();
+            if self.replacements.keys().any(|key| key.starts_with(&tail)) {
+                return start;
+            }
+        }
+        text.len()
+    }
+
+    /// Apply only the custom replacements, leaving spacing untouched, for
+    /// streaming text that is typed piece by piece.
+    pub fn apply_replacements_only(&self, text: &str) -> String {
+        if self.replacements.is_empty() {
+            return text.to_string();
+        }
+        self.apply_replacements(text)
+    }
