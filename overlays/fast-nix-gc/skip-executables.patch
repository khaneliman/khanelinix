+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn executable_exclusion_preserves_data_deduplication() {
+        for skip_executables in [false, true] {
+            for dry_run in [false, true] {
+                let tmp = tempdir().unwrap();
+                let store = tmp.path().join("store");
+                let state = tmp.path().join("state");
+                fs::create_dir_all(&store).unwrap();
+                let p1 = mk_store_path(&store, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-a", CONTENT);
+                let p2 = mk_store_path(&store, "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb-b", CONTENT);
+                let program = b"#!/bin/sh\nexit 0\n";
+                for p in [&p1, &p2] {
+                    unlock(p);
+                    fs::write(p.join("program"), program).unwrap();
+                    fs::set_permissions(p.join("program"), fs::Permissions::from_mode(0o555))
+                        .unwrap();
+                    fs::set_permissions(p, fs::Permissions::from_mode(0o555)).unwrap();
+                }
+                mk_db(&state, &[&p1, &p2]);
+                let originals = [
+                    fs::metadata(p1.join("program")).unwrap().ino(),
+                    fs::metadata(p2.join("program")).unwrap().ino(),
+                ];
+                let hash = nar_hash_nix32(&p1.join("program")).await.unwrap();
+                let options = || Options {
+                    skip_executables,
+                    dry_run,
+                    ..run_opts(&store, &state)
+                };
+                let stats = optimise_store(options()).await.unwrap();
+                assert_eq!(stats.errors.load(Ordering::Relaxed), 0);
+                assert_eq!(
+                    stats.files_linked.load(Ordering::Relaxed),
+                    if skip_executables { 1 } else { 2 }
+                );
+                let inodes = [
+                    fs::metadata(p1.join("program")).unwrap().ino(),
+                    fs::metadata(p2.join("program")).unwrap().ino(),
+                ];
+                if skip_executables || dry_run {
+                    assert_eq!(inodes, originals);
+                    assert!(!store.join(".links").join(&hash).exists());
+                } else {
+                    assert_eq!(inodes[0], inodes[1]);
+                    assert!(store.join(".links").join(&hash).exists());
+                }
+                for p in [&p1, &p2] {
+                    assert_eq!(fs::read(p.join("program")).unwrap(), program);
+                    assert_eq!(
+                        fs::metadata(p.join("program")).unwrap().mode() & 0o777,
+                        0o555
+                    );
+                    assert_eq!(nar_hash_nix32(&p.join("program")).await.unwrap(), hash);
+                }
+                if dry_run {
+                    assert!(!store.join(".links").exists());
+                } else {
+                    assert_eq!(
+                        fs::metadata(p1.join("data")).unwrap().ino(),
+                        fs::metadata(p2.join("data")).unwrap().ino()
+                    );
+                    let again = optimise_store(options()).await.unwrap();
+                    assert_eq!(again.files_linked.load(Ordering::Relaxed), 0);
+                    assert_eq!(again.errors.load(Ordering::Relaxed), 0);
+                }
+                unlock(&p1);
+                unlock(&p2);
+            }
         }
     }
 
