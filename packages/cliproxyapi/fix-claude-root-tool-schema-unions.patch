diff --git a/internal/translator/common/claude_tool_schema.go b/internal/translator/common/claude_tool_schema.go
new file mode 100644
index 000000000..45984b399
--- /dev/null
+++ b/internal/translator/common/claude_tool_schema.go
@@ -0,0 +1,102 @@
+package common
+
+import (
+	"encoding/json"
+	"slices"
+	"strings"
+
+	"github.com/tidwall/gjson"
+)
+
+const emptyClaudeToolInputSchema = `{"type":"object","properties":{}}`
+
+// NormalizeClaudeToolInputSchema removes root-level schema unions unsupported by
+// Anthropic while preserving the properties that help Claude call the tool.
+// Nested unions remain unchanged because Anthropic only rejects them at the root.
+func NormalizeClaudeToolInputSchema(parameters gjson.Result) []byte {
+	raw := strings.TrimSpace(parameters.Raw)
+	if raw == "" || raw == "null" || !gjson.Valid(raw) {
+		return []byte(emptyClaudeToolInputSchema)
+	}
+
+	var schema map[string]any
+	decoder := json.NewDecoder(strings.NewReader(raw))
+	decoder.UseNumber()
+	if err := decoder.Decode(&schema); err != nil || schema == nil {
+		return []byte(emptyClaudeToolInputSchema)
+	}
+
+	properties, _ := schema["properties"].(map[string]any)
+	if properties == nil {
+		properties = make(map[string]any)
+	}
+
+	required := stringSet(schema["required"])
+	for _, keyword := range []string{"allOf", "anyOf", "oneOf"} {
+		value, exists := schema[keyword]
+		if !exists {
+			continue
+		}
+		delete(schema, keyword)
+		branches, _ := value.([]any)
+		for _, branchValue := range branches {
+			branch, okBranch := branchValue.(map[string]any)
+			if !okBranch {
+				continue
+			}
+			if branchProperties, okProperties := branch["properties"].(map[string]any); okProperties {
+				for name, value := range branchProperties {
+					if _, exists := properties[name]; !exists {
+						properties[name] = value
+					}
+				}
+			}
+			if keyword == "allOf" {
+				for name := range stringSet(branch["required"]) {
+					required[name] = struct{}{}
+				}
+			}
+		}
+
+		if keyword == "anyOf" || keyword == "oneOf" {
+			required = make(map[string]struct{})
+		}
+	}
+
+	schema["type"] = "object"
+	schema["properties"] = properties
+	if len(required) == 0 {
+		delete(schema, "required")
+	} else {
+		schema["required"] = sortedStrings(required)
+	}
+
+	normalized, err := json.Marshal(schema)
+	if err != nil {
+		return []byte(emptyClaudeToolInputSchema)
+	}
+	return normalized
+}
+
+func stringSet(value any) map[string]struct{} {
+	result := make(map[string]struct{})
+	values, ok := value.([]any)
+	if !ok {
+		return result
+	}
+	for _, item := range values {
+		if name, okName := item.(string); okName {
+			result[name] = struct{}{}
+		}
+	}
+	return result
+}
+
+func sortedStrings(values map[string]struct{}) []string {
+	result := make([]string, 0, len(values))
+	for value := range values {
+		result = append(result, value)
+	}
+	slices.Sort(result)
+	return result
+}
diff --git a/internal/translator/common/claude_tool_schema_test.go b/internal/translator/common/claude_tool_schema_test.go
new file mode 100644
index 000000000..242fb3ae2
--- /dev/null
+++ b/internal/translator/common/claude_tool_schema_test.go
@@ -0,0 +1,79 @@
+package common
+
+import (
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestNormalizeClaudeToolInputSchema(t *testing.T) {
+	tests := []struct {
+		name        string
+		input       string
+		wantPaths   map[string]string
+		absentPaths []string
+	}{
+		{
+			name:  "invalid schema becomes empty object",
+			input: `null`,
+			wantPaths: map[string]string{
+				"type": "object",
+			},
+		},
+		{
+			name:  "oneOf properties merge and required drops",
+			input: `{"type":"object","oneOf":[{"type":"object","properties":{"query":{"type":"string"}},"required":["query"]},{"type":"object","properties":{"cursor":{"type":"string"}},"required":["cursor"]}]}`,
+			wantPaths: map[string]string{
+				"type":                   "object",
+				"properties.query.type":  "string",
+				"properties.cursor.type": "string",
+			},
+			absentPaths: []string{"oneOf", "required"},
+		},
+		{
+			name:  "constraint-only anyOf drops union and required",
+			input: `{"type":"object","properties":{"query":{"type":"string"},"id":{"type":"integer"}},"required":["stable"],"anyOf":[{"required":["query"]},{"required":["id"]}]}`,
+			wantPaths: map[string]string{
+				"properties.query.type": "string",
+				"properties.id.type":    "integer",
+			},
+			absentPaths: []string{"anyOf", "required"},
+		},
+		{
+			name:  "allOf properties and required merge",
+			input: `{"allOf":[{"type":"object","properties":{"a":{"type":"string"}},"required":["a"]},{"type":"object","properties":{"b":{"type":"boolean"}},"required":["b"]}]}`,
+			wantPaths: map[string]string{
+				"type":              "object",
+				"properties.a.type": "string",
+				"properties.b.type": "boolean",
+				"required.0":        "a",
+				"required.1":        "b",
+			},
+			absentPaths: []string{"allOf"},
+		},
+		{
+			name:  "nested union remains intact",
+			input: `{"type":"object","properties":{"value":{"oneOf":[{"type":"string"},{"type":"integer"}]}}}`,
+			wantPaths: map[string]string{
+				"properties.value.oneOf.0.type": "string",
+				"properties.value.oneOf.1.type": "integer",
+			},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			output := NormalizeClaudeToolInputSchema(gjson.Parse(test.input))
+			for path, want := range test.wantPaths {
+				if got := gjson.GetBytes(output, path).String(); got != want {
+					t.Fatalf("%s = %q, want %q; output=%s", path, got, want, output)
+				}
+			}
+			for _, path := range test.absentPaths {
+				if gjson.GetBytes(output, path).Exists() {
+					t.Fatalf("%s must be absent; output=%s", path, output)
+				}
+			}
+		})
+	}
+}
