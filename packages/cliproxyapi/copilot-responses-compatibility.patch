+func TestUseGitHubCopilotResponsesEndpoint_AdvertisedEndpoints(t *testing.T) {
+	reg := registry.GetGlobalRegistry()
+	clientID := "github-copilot-endpoint-test"
+	reg.RegisterClient(clientID, githubCopilotAuthType, []*registry.ModelInfo{
+		{ID: "gemini-3.8-flash", SupportedEndpoints: []string{githubCopilotChatPath}},
+		{ID: "endpoint-test-responses-only", SupportedEndpoints: []string{githubCopilotResponsesPath}},
+		{ID: "endpoint-test-missing", SupportedEndpoints: []string{"/messages"}},
+	})
+	defer reg.UnregisterClient(clientID)
+
+	for _, tc := range []struct {
+		name, source, model string
+		want                bool
+	}{
+		{"dynamic chat only from responses", "openai-response", "gemini-3.8-flash", false},
+		{"dynamic responses only from chat", "openai", "endpoint-test-responses-only", true},
+		{"dynamic responses only from responses", "openai-response", "endpoint-test-responses-only", true},
+		{"dynamic missing responses", "openai-response", "endpoint-test-missing", false},
+		{"static chat only from responses", "openai-response", "claude-opus-4.6", false},
+		{"static responses only from chat", "openai", "gpt-5.4", true},
+		{"static dual from responses", "openai-response", "gpt-4.1", true},
+		{"static dual from chat", "openai", "gpt-4.1", false},
+		{"unknown responses fallback", "openai-response", "endpoint-test-unknown", true},
+		{"unknown chat fallback", "openai", "endpoint-test-unknown", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := useGitHubCopilotResponsesEndpoint(sdktranslator.FromString(tc.source), tc.model); got != tc.want {
+				t.Fatalf("useGitHubCopilotResponsesEndpoint(%q, %q) = %t, want %t", tc.source, tc.model, got, tc.want)
+			}
+		})
+	}
+}
