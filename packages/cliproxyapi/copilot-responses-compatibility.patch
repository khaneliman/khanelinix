+func TestGitHubCopilotResponsesSourceUsesAdvertisedChatEndpoint(t *testing.T) {
+	const model = "gemini-3.8-flash"
+	var decoded copilotauth.CopilotModelsResponse
+	fixture := `{"data":[
+		{"id":"gemini-3.8-flash","supported_endpoints":["/chat/completions"]},
+		{"id":"gpt-6-astra","supported_endpoints":["/responses","ws:/responses"]},
+		{"id":"claude-opus-5.5","supported_endpoints":["/v1/messages","/chat/completions"]},
+		{"id":"gpt-5"}
+	]}`
+	if err := json.Unmarshal([]byte(fixture), &decoded); err != nil {
+		t.Fatal(err)
+	}
+	models := buildGitHubCopilotModelInfos(decoded.Data)
+	reg := registry.GetGlobalRegistry()
+	clientID := "github-copilot-chat-route-test"
+	reg.RegisterClient(clientID, githubCopilotAuthType, models)
+	defer reg.UnregisterClient(clientID)
+	if info := reg.GetModelInfo(model, githubCopilotAuthType); info == nil || !containsEndpoint(info.SupportedEndpoints, githubCopilotChatPath) {
+		t.Fatalf("decoded dynamic chat endpoints not registered: %+v", info)
+	}
+	if useGitHubCopilotResponsesEndpoint(sdktranslator.FromString("openai-response"), "claude-opus-5.5") {
+		t.Fatal("advertised Claude chat endpoint must not select /responses")
+	}
+	if !useGitHubCopilotResponsesEndpoint(sdktranslator.FromString("openai"), "gpt-6-astra") {
+		t.Fatal("decoded responses-only endpoints must select /responses")
+	}
+	if !useGitHubCopilotResponsesEndpoint(sdktranslator.FromString("openai-response"), "gpt-5") {
+		t.Fatal("absent dynamic endpoints must retain static /responses support")
+	}
+
+	for _, tc := range []struct {
+		name      string
+		streaming bool
+		done      bool
+	}{
+		{name: "nonstream"},
+		{name: "stream", streaming: true, done: true},
+		{name: "stream without done", streaming: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != githubCopilotChatPath {
+					t.Errorf("path = %q, want %q", r.URL.Path, githubCopilotChatPath)
+					http.Error(w, "wrong endpoint", http.StatusBadRequest)
+					return
+				}
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				if !gjson.GetBytes(body, "messages").IsArray() || gjson.GetBytes(body, "input").Exists() {
+					t.Errorf("chat request not translated: %s", body)
+				}
+				if tc.streaming {
+					w.Header().Set("Content-Type", "text/event-stream")
+					wire := "data: {\"id\":\"chatcmpl_1\",\"object\":\"chat.completion.chunk\",\"model\":\"gemini-3.8-flash\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"hello\"},\"finish_reason\":null}]}\n\n" +
+						"data: {\"id\":\"chatcmpl_1\",\"object\":\"chat.completion.chunk\",\"model\":\"gemini-3.8-flash\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n" +
+						"data: {\"id\":\"chatcmpl_1\",\"object\":\"chat.completion.chunk\",\"model\":\"gemini-3.8-flash\",\"choices\":[],\"usage\":{\"prompt_tokens\":4,\"completion_tokens\":5,\"total_tokens\":9}}\n\n"
+					if tc.done {
+						wire += "data: [DONE]\n\n"
+					}
+					_, _ = io.WriteString(w, wire)
+				} else {
+					w.Header().Set("Content-Type", "application/json")
+					_, _ = io.WriteString(w, `{"id":"chatcmpl_1","object":"chat.completion","model":"gemini-3.8-flash","choices":[{"index":0,"message":{"role":"assistant","content":"hello"},"finish_reason":"stop"}]}`)
+				}
+			}))
+			defer server.Close()
+			e := NewGitHubCopilotExecutor(&config.Config{})
+			e.cache["test-token"] = &cachedAPIToken{token: "test-api-token", apiEndpoint: server.URL, expiresAt: time.Now().Add(time.Hour)}
+			auth := &cliproxyauth.Auth{Metadata: map[string]any{"access_token": "test-token"}}
+			payload := []byte(`{"model":"gemini-3.8-flash","input":"say hello"}`)
+			req := cliproxyexecutor.Request{Model: model, Payload: payload}
+			opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai-response"), OriginalRequest: payload}
+			if tc.streaming {
+				result, err := e.ExecuteStream(context.Background(), auth, req, opts)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var joined strings.Builder
+				for chunk := range result.Chunks {
+					if chunk.Err != nil {
+						t.Fatal(chunk.Err)
+					}
+					joined.Write(chunk.Payload)
+				}
+				if !strings.Contains(joined.String(), "response.output_text.delta") || !strings.Contains(joined.String(), "hello") {
+					t.Fatalf("stream not translated to Responses: %q", joined.String())
+				}
+				completed := strings.Count(joined.String(), "event: response.completed")
+				if tc.done {
+					if completed != 1 || !strings.Contains(joined.String(), `"total_tokens":9`) {
+						t.Fatalf("terminal event count = %d or late usage missing: %q", completed, joined.String())
+					}
+				} else if completed != 0 {
+					t.Fatalf("stream without [DONE] emitted response.completed: %q", joined.String())
+				}
+			} else {
+				result, err := e.Execute(context.Background(), auth, req, opts)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if gjson.GetBytes(result.Payload, "object").String() != "response" || !strings.Contains(string(result.Payload), "hello") {
+					t.Fatalf("nonstream not translated to Responses: %s", result.Payload)
+				}
+			}
+		})
+	}
 }
 
