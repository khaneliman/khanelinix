+// ClaudeRequestVersion keeps Agent SDK client versions independent of the CLI
+// cloaking baseline. These clients still receive the existing cloaking policy.
+func ClaudeRequestVersion(headers http.Header, cfg *config.Config) string {
+	userAgent := strings.TrimSpace(headerValue(headers, "User-Agent"))
+	entrypoint, sdkVersion := parseClaudeCodeUserAgentDetails(userAgent)
+	if headerValue(headers, "X-App") == "cli" &&
+		(entrypoint == "sdk-ts" || entrypoint == "sdk-py") && sdkVersion != "" &&
+		claudeCodeNativeUserAgentPattern.MatchString(userAgent) {
+		if matches := claudeCLIVersionPattern.FindStringSubmatch(userAgent); len(matches) == 4 {
+			return strings.Join(matches[1:], ".")
+		}
+	}
+	return DefaultClaudeVersion(cfg)
+}
