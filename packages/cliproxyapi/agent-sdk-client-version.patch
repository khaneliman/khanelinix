+		{"python", "claude-cli/2.1.281 (external, sdk-py, agent-sdk/0.1.0)", "cli", "2.1.281"},
+		{"future", "claude-cli/3.0.0 (external, sdk-ts, agent-sdk/1.0.0)", "cli", "3.0.0"},
+		{"missing app", "claude-cli/2.1.280 (external, sdk-ts, agent-sdk/0.3.276)", "", "2.1.258"},
+		{"unknown client", "claude-cli/2.1.280 (external, copied-client)", "cli", "2.1.258"},
+		{"malformed", "claude-cli/2.1.280 (external, sdk-ts, agent-sdk/bad)", "cli", "2.1.258"},
+		{"missing sdk", "claude-cli/2.1.280 (external, sdk-ts)", "cli", "2.1.258"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			headers := http.Header{"User-Agent": {test.ua}, "X-App": {test.app}}
