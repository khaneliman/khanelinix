#define _GNU_SOURCE

#include <dlfcn.h>
#include <errno.h>
#include <fcntl.h>
#include <openssl/evp.h>
#include <openssl/ssl.h>
#include <openssl/x509.h>
#include <pthread.h>
#include <spawn.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

#include "antigravity-cert.h"

char **antigravity_argv(const char *path, char *const argv[]);

static pthread_once_t symbols_once = PTHREAD_ONCE_INIT;
static __typeof__(X509_verify_cert) *real_X509_verify_cert;
static __typeof__(SSL_get_verify_result) *real_SSL_get_verify_result;
static __typeof__(execve) *real_execve;
static __typeof__(posix_spawn) *real_posix_spawn;
static __typeof__(posix_spawnp) *real_posix_spawnp;
static __typeof__(access) *real_access;
static __typeof__(open) *real_open;
static __typeof__(open64) *real_open64;
static __typeof__(openat) *real_openat;
static __typeof__(openat64) *real_openat64;
static __typeof__(fopen) *real_fopen;
static __typeof__(fopen64) *real_fopen64;
static __typeof__(fstatat) *real_fstatat;
static __typeof__(stat) *real_stat;
static __typeof__(lstat) *real_lstat;

static void load_symbols(void) {
  int saved_errno = errno;
  real_X509_verify_cert = dlsym(RTLD_NEXT, "X509_verify_cert");
  real_SSL_get_verify_result = dlsym(RTLD_NEXT, "SSL_get_verify_result");
  real_execve = dlsym(RTLD_NEXT, "execve");
  real_posix_spawn = dlsym(RTLD_NEXT, "posix_spawn");
  real_posix_spawnp = dlsym(RTLD_NEXT, "posix_spawnp");
  real_access = dlsym(RTLD_NEXT, "access");
  real_open = dlsym(RTLD_NEXT, "open");
  real_open64 = dlsym(RTLD_NEXT, "open64");
  real_openat = dlsym(RTLD_NEXT, "openat");
  real_openat64 = dlsym(RTLD_NEXT, "openat64");
  real_fopen = dlsym(RTLD_NEXT, "fopen");
  real_fopen64 = dlsym(RTLD_NEXT, "fopen64");
  real_fstatat = dlsym(RTLD_NEXT, "fstatat");
  real_stat = dlsym(RTLD_NEXT, "stat");
  real_lstat = dlsym(RTLD_NEXT, "lstat");
  errno = saved_errno;
}

#define ZONEINFO_PREFIX "/usr/share/zoneinfo"

static const char *redirect_path(const char *path) {
  if (path == NULL) {
    return NULL;
  }

  if (strcmp(path, "/bin/ps") == 0) {
    return "@ps@";
  }

  if (strcmp(path, "/usr/bin/lsof") == 0 ||
      strcmp(path, "/usr/sbin/lsof") == 0) {
    return "@lsof@";
  }

  if (strcmp(path, "/usr/bin/which") == 0 || strcmp(path, "/bin/which") == 0) {
    return "@which@";
  }

  // Foundation's CFTimeZone hardcodes /usr/share/zoneinfo and traps
  // (SIGILL) when the lookup fails, so point it at Nix tzdata.
  const size_t prefix_length = sizeof(ZONEINFO_PREFIX) - 1;
  if (strncmp(path, ZONEINFO_PREFIX, prefix_length) == 0 &&
      (path[prefix_length] == '/' || path[prefix_length] == '\0')) {
    static __thread char buf[4096];
    int written = snprintf(buf, sizeof(buf), "@tzdata@%s",
                           path + prefix_length);
    if (written > 0 && (size_t)written < sizeof(buf)) {
      return buf;
    }
  }

  return path;
}

__attribute__((constructor)) static void drop_preload_for_children(void) {
  unsetenv("LD_PRELOAD");
}

static int certificate_matches_antigravity(X509 *cert) {
  unsigned char fingerprint[EVP_MAX_MD_SIZE];
  unsigned int fingerprint_length = 0;

  if (cert == NULL) {
    return 0;
  }

  if (X509_digest(cert, EVP_sha256(), fingerprint, &fingerprint_length) != 1) {
    return 0;
  }

  return fingerprint_length == SHA256_DIGEST_LENGTH &&
         memcmp(fingerprint, antigravity_fingerprint, SHA256_DIGEST_LENGTH) ==
             0;
}

int X509_verify_cert(X509_STORE_CTX *ctx) {
  pthread_once(&symbols_once, load_symbols);
  if (real_X509_verify_cert == NULL || ctx == NULL) {
    if (ctx != NULL) {
      X509_STORE_CTX_set_error(ctx, X509_V_ERR_UNSPECIFIED);
    }
    return -1;
  }

  int result = real_X509_verify_cert(ctx);
  if (result == 1) {
    return result;
  }

  if (certificate_matches_antigravity(X509_STORE_CTX_get0_cert(ctx))) {
    return 1;
  }

  return result;
}

long SSL_get_verify_result(const SSL *ssl) {
  pthread_once(&symbols_once, load_symbols);
  if (real_SSL_get_verify_result == NULL || ssl == NULL) {
    return X509_V_ERR_UNSPECIFIED;
  }

  long result = real_SSL_get_verify_result(ssl);
  if (result == X509_V_OK) {
    return result;
  }

  X509 *cert = SSL_get1_peer_certificate(ssl);
  int matches = certificate_matches_antigravity(cert);
  X509_free(cert);

  return matches ? X509_V_OK : result;
}

int execve(const char *path, char *const argv[], char *const envp[]) {
  pthread_once(&symbols_once, load_symbols);
  if (real_execve == NULL) {
    errno = ENOSYS;
    return -1;
  }

  return real_execve(redirect_path(path), argv, envp);
}

int posix_spawn(pid_t *pid, const char *path,
                const posix_spawn_file_actions_t *file_actions,
                const posix_spawnattr_t *attrp, char *const argv[],
                char *const envp[]) {
  pthread_once(&symbols_once, load_symbols);
  if (real_posix_spawn == NULL) {
    return ENOSYS;
  }

  char **args = antigravity_argv(path, argv);
  if (args == NULL) {
    return ENOMEM;
  }
  int result = real_posix_spawn(pid, redirect_path(path), file_actions, attrp,
                                args, envp);
  if (args != argv) {
    free(args);
  }
  return result;
}

int posix_spawnp(pid_t *pid, const char *file,
                 const posix_spawn_file_actions_t *file_actions,
                 const posix_spawnattr_t *attrp, char *const argv[],
                 char *const envp[]) {
  pthread_once(&symbols_once, load_symbols);
  if (real_posix_spawnp == NULL) {
    return ENOSYS;
  }

  return real_posix_spawnp(pid, redirect_path(file), file_actions, attrp, argv,
                           envp);
}

int access(const char *path, int mode) {
  pthread_once(&symbols_once, load_symbols);
  if (real_access == NULL) {
    errno = ENOSYS;
    return -1;
  }

  return real_access(redirect_path(path), mode);
}

static int open_needs_mode(int flags) {
  // O_TMPFILE includes O_DIRECTORY, which alone does not take a mode.
  return (flags & O_CREAT) || (flags & O_TMPFILE) == O_TMPFILE;
}

int open(const char *path, int flags, ...) {
  pthread_once(&symbols_once, load_symbols);
  if (real_open == NULL) {
    errno = ENOSYS;
    return -1;
  }

  mode_t mode = 0;
  if (open_needs_mode(flags)) {
    va_list args;
    va_start(args, flags);
    mode = va_arg(args, mode_t);
    va_end(args);
  }

  return real_open(redirect_path(path), flags, mode);
}

int open64(const char *path, int flags, ...) {
  pthread_once(&symbols_once, load_symbols);
  if (real_open64 == NULL) {
    errno = ENOSYS;
    return -1;
