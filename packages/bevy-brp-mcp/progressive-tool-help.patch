+/// Extract and join Rust documentation attributes for a concise tool description.
+fn extract_doc(attributes: &[Attribute]) -> String {
+    let description = attributes
+        .iter()
+        .filter(|attribute| attribute.path().is_ident("doc"))
+        .filter_map(|attribute| match &attribute.meta {
+            Meta::NameValue(meta) => match &meta.value {
+                Expr::Lit(expr) => match &expr.lit {
+                    Lit::Str(value) => Some(value.value().trim().to_string()),
+                    _ => None,
+                },
+                _ => None,
+            },
+            _ => None,
+        })
+        .collect::<Vec<_>>()
+        .join(" ");
+
+    assert!(
+        !description.is_empty(),
+        "ToolDescription variants require a documentation comment"
+    );
+
+    description
+}
