diff --git a/mcp/src/tool/help.rs b/mcp/src/tool/help.rs
new file mode 100644
index 0000000..622f6b7
--- /dev/null
+++ b/mcp/src/tool/help.rs
@@ -0,0 +1,60 @@
+//! On-demand detailed tool guidance.
+
+use std::str::FromStr;
+
+use bevy_brp_mcp_macros::ParamStruct;
+use bevy_brp_mcp_macros::ResultStruct;
+use bevy_brp_mcp_macros::ToolFn;
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+
+use super::ToolName;
+use crate::error::Error;
+use crate::error::Result;
+use crate::tool::HandlerContext;
+use crate::tool::HandlerResult;
+use crate::tool::ToolFn;
+use crate::tool::ToolResult;
+
+/// Parameters for detailed MCP tool guidance.
+#[derive(Clone, Deserialize, Serialize, JsonSchema, ParamStruct)]
+pub struct ToolHelpParams {
+    /// Exact MCP tool name, such as `world_query`.
+    pub tool_name: String,
+}
+
+/// Detailed guidance for one MCP tool.
+#[derive(Debug, Clone, Serialize, Deserialize, ResultStruct)]
+pub struct ToolHelpResult {
+    /// Exact MCP tool name.
+    #[to_metadata]
+    tool_name: String,
+
+    /// Detailed usage guidance and examples.
+    #[to_result]
+    help: String,
+
+    /// Message template for formatting responses.
+    #[to_message(message_template = "Detailed help for {tool_name}")]
+    message_template: String,
+}
+
+/// Returns detailed guidance for one advertised MCP tool.
+#[derive(ToolFn)]
+#[tool_fn(params = "ToolHelpParams", output = "ToolHelpResult")]
+pub struct BrpToolHelp;
+
+#[allow(
+    clippy::unused_async,
+    reason = "ToolFn trait requires async handler signature"
+)]
+async fn handle_impl(params: ToolHelpParams) -> Result<ToolHelpResult> {
+    let tool = ToolName::from_str(&params.tool_name)
+        .map_err(|_| Error::invalid("tool_name", &params.tool_name))?;
+
+    Ok(ToolHelpResult::new(
+        params.tool_name,
+        tool.help().to_string(),
+    ))
+}
