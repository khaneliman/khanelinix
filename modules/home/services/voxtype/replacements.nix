# Developer terms the speech model splits or mishears. Keys match
# case-insensitively on word boundaries. `voxtype learn` writes personal
# corrections to ~/.local/state/voxtype/learned-replacements.toml; promote
# stable entries from there into this file.
{
  "git hub" = "GitHub";
  "hyperland" = "Hyprland";
  "java script" = "JavaScript";
  "neo vim" = "Neovim";
  "nix os" = "NixOS";
  "nixflake" = "nix flake";
  "type script" = "TypeScript";
}
