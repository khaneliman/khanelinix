new file mode 100644
--- /dev/null
+++ b/apps/server/src/provider/Drivers/AntigravitySkills.ts
@@ -0,0 +1,119 @@
+/**
+ * AntigravitySkills — filesystem discovery of Antigravity skills for the `$` picker.
+ *
+ * The Antigravity CLI loads skills from `<home dir>/skills` (user scope) and
+ * workspace `.agents/skills` (project scope), one directory per skill with a
+ * `SKILL.md` carrying YAML frontmatter. The CLI injects only skill names and
+ * descriptions into model context; its agentapi protocol exposes no skill
+ * listing, so the provider snapshot scans the same locations directly,
+ * mirroring ClaudeSkills. Later roots win on name collisions, so a project
+ * skill overrides a user skill of the same name, matching the CLI's
+ * workspace-over-global customization precedence.
+ *
+ * @module provider/Drivers/AntigravitySkills
+ */
+import * as NodeFS from "node:fs";
+import * as NodePath from "node:path";
+
+import type { ServerProviderSkill } from "@t3tools/contracts";
+import { parse as parseYamlDocument } from "yaml";
+
+type AntigravitySkillScope = "user" | "project";
+
+const FRONTMATTER_PATTERN = /^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/;
+
+type SkillFrontmatter =
+  | { readonly kind: "missing" }
+  | { readonly kind: "malformed" }
+  | { readonly kind: "parsed"; readonly name?: string; readonly description?: string };
+
+function parseSkillFrontmatter(contents: string): SkillFrontmatter {
+  const match = FRONTMATTER_PATTERN.exec(contents);
+  if (!match) {
+    return { kind: "missing" };
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = parseYamlDocument(match[1] ?? "");
+  } catch {
+    return { kind: "malformed" };
+  }
+  if (typeof parsed !== "object" || parsed === null) {
+    return { kind: "malformed" };
+  }
+
+  const record = parsed as Record<string, unknown>;
+  const name = typeof record.name === "string" ? record.name.trim() : "";
+  const description = typeof record.description === "string" ? record.description.trim() : "";
+  return {
+    kind: "parsed",
+    ...(name ? { name } : {}),
+    ...(description ? { description } : {}),
+  };
+}
+
+/**
+ * Enumerate Antigravity skills from the resolved home directory and workspace
+ * `.agents/skills`. Discovery is best-effort: unreadable roots and malformed
+ * skill entries are skipped so a broken skill never degrades the provider
+ * snapshot. Synchronous `node:fs` keeps the status check's Effect requirements
+ * unchanged; the scan reads a handful of small files once per snapshot
+ * refresh.
+ */
+export function discoverAntigravitySkills(input: {
+  readonly homeDirPath: string;
+  readonly cwd?: string | undefined;
+}): ReadonlyArray<ServerProviderSkill> {
+  const roots: ReadonlyArray<{ directory: string; scope: AntigravitySkillScope }> = [
+    { directory: NodePath.join(input.homeDirPath, "skills"), scope: "user" },
+    ...(input.cwd
+      ? [{ directory: NodePath.join(input.cwd, ".agents", "skills"), scope: "project" as const }]
+      : []),
+  ];
+
+  const skillsByName = new Map<string, ServerProviderSkill>();
+  for (const root of roots) {
+    let entries: ReadonlyArray<string>;
+    try {
+      entries = NodeFS.readdirSync(root.directory);
+    } catch {
+      continue;
+    }
+
+    for (const entry of [...entries].sort()) {
+      const skillPath = NodePath.join(root.directory, entry, "SKILL.md");
+      let contents: string;
+      try {
+        contents = NodeFS.readFileSync(skillPath, "utf8");
+      } catch {
+        continue;
+      }
+
+      const frontmatter = parseSkillFrontmatter(contents);
+      // Malformed frontmatter means the skill won't load in the Antigravity
+      // CLI either — skip it rather than surfacing a broken entry under its
+      // directory name.
+      if (frontmatter.kind === "malformed") {
+        continue;
+      }
+
+      const name = (frontmatter.kind === "parsed" ? frontmatter.name : undefined) ?? entry.trim();
+      if (!name) {
+        continue;
+      }
+
+      skillsByName.set(name, {
+        name,
+        path: skillPath,
+        enabled: true,
+        scope: root.scope,
+        ...(frontmatter.kind === "parsed" && frontmatter.description
+          ? { description: frontmatter.description }
+          : {}),
+      });
+    }
+  }
+
+  return [...skillsByName.values()].sort((left, right) => left.name.localeCompare(right.name));
+}
