+    }).pipe(
+      Effect.provide(NodeServices.layer),
+      Effect.provideService(
+        HttpClient.HttpClient,
+        HttpClient.make(() => Effect.die("unexpected request")),
+      ),
+    ),
+  );
+
+  it.effect("bounds a stalled credential read and allows a later quota read to recover", () =>
+    Effect.gen(function* () {
+      const fixture = yield* makeFixture({ contents: encodeJson(credentials) });
+      const requested = yield* Deferred.make<void>();
+      const contents = yield* Ref.make<Effect.Effect<string>>(
+        Deferred.succeed(requested, undefined).pipe(Effect.andThen(Effect.never)),
+      );
+      const reader = yield* makeAntigravityUsageLimits({
+        enabled: true,
+        authMethod: "oauth-personal",
+        tokenPath: fixture.tokenPath,
+      }).pipe(
+        Effect.provideService(FileSystem.FileSystem, {
+          ...fixture.fs,
+          readFileString: () => Ref.get(contents).pipe(Effect.flatten),
+        }),
+      );
+      const pending = yield* reader.read.pipe(Effect.timeout("3 seconds"), Effect.forkChild);
+      yield* Deferred.await(requested);
+      yield* TestClock.adjust("3 seconds");
+      expect((yield* Fiber.join(pending)).unavailable).toEqual({
+        reason: "probeFailed",
+        message: "Antigravity could not read usage limits.",
+      });
+      yield* Ref.set(contents, Effect.succeed(encodeJson({ ...credentials, token: "valid" })));
+      expect((yield* reader.read).windows).toHaveLength(4);
+    }).pipe(
+      Effect.provide(NodeServices.layer),
+      Effect.provideService(
+        HttpClient.HttpClient,
+        HttpClient.make((request) =>
+          Effect.succeed(HttpClientResponse.fromWeb(request, Response.json(summary))),
+        ),
+      ),
+    ),
+  );
+
+  it.effect.each(["gemini-api-key", "agent-platform", "oauth-business"] as const)(
+    "does not query personal subscription quotas for %s",
+    (authMethod) =>
+      Effect.gen(function* () {
+        const fixture = yield* makeFixture({ authMethod, contents: encodeJson(credentials) });
