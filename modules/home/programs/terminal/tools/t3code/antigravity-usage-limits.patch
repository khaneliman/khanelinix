+        expect(yield* fixture.credentialFingerprint).toBeUndefined();
+      }).pipe(Effect.provide(NodeServices.layer)),
+  );
+
+  it.effect("retries an expired stored access token once", () =>
+    Effect.gen(function* () {
+      const fixture = yield* makeFixture({
