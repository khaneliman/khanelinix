+}
+
+/** Host folders use their own explorer root without changing the thread's workspace. */
+export function resolveFilePreviewLocation(input: {
+  readonly cwd: string;
+  readonly relativePath: string | null;
+  readonly isNotFile: boolean;
+  readonly attachmentOpen: boolean;
+}) {
+  const isDirectory = input.isNotFile && !input.attachmentOpen;
+  const hostDirectory =
+    isDirectory && input.relativePath !== null && isAbsolutePath(input.relativePath)
+      ? input.relativePath
+      : null;
+  return {
+    isDirectory,
+    hostDirectory,
+    explorerCwd: hostDirectory ?? input.cwd,
+    previewPath: isDirectory ? null : input.relativePath,
+  };
 }
 
 export const isMarkdownPreviewFile = (path: string): boolean => /\.(?:md|mdx)$/i.test(path);
