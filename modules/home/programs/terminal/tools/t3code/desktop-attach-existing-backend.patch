diff --git a/apps/desktop/src/backend/DesktopExistingBackendAttachment.test.ts b/apps/desktop/src/backend/DesktopExistingBackendAttachment.test.ts
new file mode 100644
index 0000000..96ab3fc
--- /dev/null
+++ b/apps/desktop/src/backend/DesktopExistingBackendAttachment.test.ts
@@ -0,0 +1,243 @@
+import { assert, describe, it } from "@effect/vitest";
+import { AuthAdministrativeScopes } from "@t3tools/contracts";
+import { spawn } from "node:child_process";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import * as Ref from "effect/Ref";
+
+import * as DesktopExistingBackendAttachment from "./DesktopExistingBackendAttachment.ts";
+
+describe("DesktopExistingBackendAttachment", () => {
+  const runtime = JSON.stringify({
+    version: 1,
+    pid: 42,
+    origin: "http://127.0.0.1:3773",
+    port: 3773,
+  });
+  const makeAttachment = (
+    input: {
+      readonly enabled?: boolean;
+      readonly runtimeJson?: string;
+      readonly expectedPort?: number;
+      readonly environmentId?: string;
+      readonly isProcessAlive?: (pid: number) => boolean;
+      readonly descriptorId?: string;
+      readonly sessionJson?: string;
+      readonly issueSession?: () => Effect.Effect<string, unknown>;
+    } = {},
+  ) =>
+    DesktopExistingBackendAttachment.makeWithOperations({
+      enabled: input.enabled ?? true,
+      stateDir: "/state",
+      expectedPort: input.expectedPort ?? 3773,
+      joinPath: (first, second) => `${first}/${second}`,
+      operations: {
+        readFileString: (path) =>
+          Effect.succeed(
+            path.endsWith("server-runtime.json")
+              ? (input.runtimeJson ?? runtime)
+              : (input.environmentId ?? "environment-1"),
+          ),
+        isProcessAlive: input.isProcessAlive ?? (() => true),
+        fetchDescriptor: () =>
+          Effect.succeed({
+            environmentId: input.descriptorId ?? "environment-1",
+            label: "Canonical server",
+          }),
+        issueSession:
+          input.issueSession ??
+          (() =>
+            Effect.succeed(
+              input.sessionJson ??
+                JSON.stringify({ token: "bearer", scopes: AuthAdministrativeScopes }),
+            )),
+      },
+    });
+
+  it.effect("does not resolve or issue a session when attachment is disabled", () =>
+    Effect.gen(function* () {
+      const issueCount = yield* Ref.make(0);
+      const attachment = yield* makeAttachment({
+        enabled: false,
+        issueSession: () => Ref.update(issueCount, (count) => count + 1).pipe(Effect.as("")),
+      });
+      yield* attachment.bootstrap;
+      assert.deepEqual(yield* attachment.state, { kind: "disabled" });
+      assert.strictEqual(yield* Ref.get(issueCount), 0);
+    }),
+  );
+
+  it.effect("accepts a live loopback runtime with a matching port", () =>
+    Effect.gen(function* () {
+      const origin = yield* DesktopExistingBackendAttachment.validateRuntimeOrigin(
+        {
+          origin: "http://127.0.0.1:3773",
+          port: 3773,
+        },
+        3773,
+      );
+      assert.strictEqual(origin.href, "http://127.0.0.1:3773/");
+      assert.isTrue(DesktopExistingBackendAttachment.processIsAlive(process.pid));
+    }),
+  );
+
+  it.effect("runs bootstrap and retains the validated descriptor label and bearer", () =>
+    Effect.gen(function* () {
+      const attachment = yield* makeAttachment();
+      yield* attachment.bootstrap;
+      const ready = yield* attachment.ready;
+      assert.isTrue(Option.isSome(ready));
+      if (Option.isSome(ready)) {
+        assert.strictEqual(ready.value.bearer, "bearer");
+        assert.strictEqual(ready.value.label, "Canonical server");
+      }
+    }),
+  );
+
+  it.effect("rejects a stale process", () =>
+    Effect.gen(function* () {
+      const attachment = yield* makeAttachment({ isProcessAlive: () => false });
+      const error = yield* attachment.bootstrap.pipe(Effect.flip);
+      assert.include(error.reason, "no longer running");
+      assert.isFalse(DesktopExistingBackendAttachment.processIsAlive(2_147_483_647));
+    }),
+  );
+
+  it.effect("rejects non-loopback and mismatched runtime origins", () =>
+    Effect.gen(function* () {
+      const nonLoopback = yield* DesktopExistingBackendAttachment.validateRuntimeOrigin(
+        {
+          origin: "http://192.0.2.1:3773",
+          port: 3773,
+        },
+        3773,
+      ).pipe(Effect.flip);
+      const mismatchedPort = yield* DesktopExistingBackendAttachment.validateRuntimeOrigin(
+        {
+          origin: "http://127.0.0.1:3774",
+          port: 3773,
+        },
+        3773,
+      ).pipe(Effect.flip);
+      const nonCanonicalPort = yield* DesktopExistingBackendAttachment.validateRuntimeOrigin(
+        {
+          origin: "http://127.0.0.1:3774",
+          port: 3774,
+        },
+        3773,
+      ).pipe(Effect.flip);
+      assert.include(nonLoopback.reason, "not loopback");
+      assert.include(mismatchedPort.reason, "port");
+      assert.include(nonCanonicalPort.reason, "configured attachment port 3773");
+    }),
+  );
+
+  it.effect("rejects zero and negative runtime PIDs before probing liveness", () =>
+    Effect.gen(function* () {
+      const probedPids: number[] = [];
+      const isProcessAlive = (pid: number) => {
+        probedPids.push(pid);
+        return true;
+      };
+      for (const pid of [0, -1]) {
+        const attachment = yield* makeAttachment({
+          runtimeJson: JSON.stringify({
+            version: 1,
+            pid,
+            origin: "http://127.0.0.1:3773",
+            port: 3773,
+          }),
+          isProcessAlive,
+        });
+        const error = yield* attachment.bootstrap.pipe(Effect.flip);
+        assert.include(error.reason, "pid is not positive");
+      }
+      assert.deepEqual(probedPids, []);
+    }),
+  );
+
+  it.effect("does not take ownership of an attached external process", () =>
+    Effect.gen(function* () {
+      const child = yield* Effect.acquireRelease(
+        Effect.sync(() =>
+          spawn(process.execPath, ["-e", "setInterval(() => {}, 1000)"], {
+            stdio: "ignore",
+          }),
+        ),
+        (process) => Effect.sync(() => process.kill()),
+      );
+      if (child.pid === undefined) return yield* Effect.die("external process has no pid");
+      const pid = child.pid;
+      yield* Effect.scoped(
+        Effect.gen(function* () {
+          const attachment = yield* makeAttachment({
+            runtimeJson: JSON.stringify({
+              version: 1,
+              pid,
+              origin: "http://127.0.0.1:3773",
+              port: 3773,
+            }),
+            isProcessAlive: DesktopExistingBackendAttachment.processIsAlive,
+          });
+          yield* attachment.bootstrap;
+        }),
+      );
+      assert.isTrue(DesktopExistingBackendAttachment.processIsAlive(pid));
+    }).pipe(Effect.scoped),
+  );
+
+  it.effect("rejects empty and mismatched environment IDs", () =>
+    Effect.gen(function* () {
+      const emptyAttachment = yield* makeAttachment({ environmentId: "" });
+      const mismatchAttachment = yield* makeAttachment({ descriptorId: "other" });
+      const empty = yield* emptyAttachment.bootstrap.pipe(Effect.flip);
+      const mismatch = yield* mismatchAttachment.bootstrap.pipe(Effect.flip);
+      assert.include(empty.reason, "empty");
+      assert.include(mismatch.reason, "does not match");
+    }),
+  );
+
+  it.effect("rejects a non-loopback origin during bootstrap", () =>
+    Effect.gen(function* () {
+      const attachment = yield* makeAttachment({
+        runtimeJson: JSON.stringify({
+          version: 1,
+          pid: 42,
+          origin: "http://192.0.2.1:3773",
+          port: 3773,
+        }),
+      });
+      const error = yield* attachment.bootstrap.pipe(Effect.flip);
+      assert.include(error.reason, "not loopback");
+    }),
+  );
+
+  it.effect("rejects invalid session JSON and missing administrative scopes", () =>
+    Effect.gen(function* () {
+      const invalidAttachment = yield* makeAttachment({ sessionJson: "not-json" });
+      const missingScopeAttachment = yield* makeAttachment({
+        sessionJson: JSON.stringify({ token: "bearer", scopes: [] }),
+      });
+      const invalid = yield* invalidAttachment.bootstrap.pipe(Effect.flip);
+      const missingScope = yield* missingScopeAttachment.bootstrap.pipe(Effect.flip);
+      assert.include(invalid.reason, "JSON");
+      assert.include(missingScope.reason, "scope");
+    }),
+  );
+
+  it.effect("serializes concurrent bootstrap calls and issues one session", () =>
+    Effect.gen(function* () {
+      const issueCount = yield* Ref.make(0);
+      const attachment = yield* makeAttachment({
+        issueSession: () =>
+          Ref.update(issueCount, (count) => count + 1).pipe(
+            Effect.as(JSON.stringify({ token: "bearer", scopes: AuthAdministrativeScopes })),
+          ),
+      });
+      yield* Effect.all([attachment.bootstrap, attachment.bootstrap], {
+        concurrency: "unbounded",
+      });
+      assert.strictEqual(yield* Ref.get(issueCount), 1);
+    }),
+  );
+});
diff --git a/apps/desktop/src/backend/DesktopExistingBackendAttachment.ts b/apps/desktop/src/backend/DesktopExistingBackendAttachment.ts
new file mode 100644
index 0000000..bd1fb35
--- /dev/null
+++ b/apps/desktop/src/backend/DesktopExistingBackendAttachment.ts
@@ -0,0 +1,316 @@
+import { fetchRemoteEnvironmentDescriptor } from "@t3tools/client-runtime/environment";
+import { AuthAdministrativeScopes, TrimmedNonEmptyString } from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Ref from "effect/Ref";
+import * as Schema from "effect/Schema";
+import * as Semaphore from "effect/Semaphore";
+import { ChildProcess, ChildProcessSpawner } from "effect/unstable/process";
+import * as HttpClient from "effect/unstable/http/HttpClient";
+
+import * as DesktopEnvironment from "../app/DesktopEnvironment.ts";
+
+const ATTACHMENT_TIMEOUT = "10 seconds";
+
+const ServerRuntimeState = Schema.fromJsonString(
+  Schema.Struct({
+    version: Schema.Literal(1),
+    pid: Schema.Int,
+    origin: Schema.String,
+    port: Schema.Int,
+  }),
+);
+const IssuedSession = Schema.fromJsonString(
+  Schema.Struct({
+    token: TrimmedNonEmptyString,
+    scopes: Schema.Array(Schema.String),
+  }),
+);
+
+export class DesktopExistingBackendAttachmentError extends Schema.TaggedErrorClass<DesktopExistingBackendAttachmentError>()(
+  "DesktopExistingBackendAttachmentError",
+  { reason: Schema.String, cause: Schema.optionalKey(Schema.Defect()) },
+) {
+  override get message(): string {
+    return `Unable to attach to the existing T3 server: ${this.reason}`;
+  }
+}
+
+export type DesktopExistingBackendAttachmentState =
+  | { readonly kind: "disabled" }
+  | { readonly kind: "resolving" }
+  | {
+      readonly kind: "ready";
+      readonly httpBaseUrl: URL;
+      readonly bearer: string;
+      readonly label: string;
+    }
+  | { readonly kind: "failed"; readonly error: DesktopExistingBackendAttachmentError };
+
+export class DesktopExistingBackendAttachment extends Context.Service<
+  DesktopExistingBackendAttachment,
+  {
+    readonly bootstrap: Effect.Effect<void, DesktopExistingBackendAttachmentError>;
+    readonly state: Effect.Effect<DesktopExistingBackendAttachmentState>;
+    readonly ready: Effect.Effect<
+      Option.Option<Extract<DesktopExistingBackendAttachmentState, { readonly kind: "ready" }>>
+    >;
+  }
+>()("@t3tools/desktop/backend/DesktopExistingBackendAttachment") {}
+
+export const isLoopback = (url: URL): boolean =>
+  url.protocol === "http:" &&
+  (url.hostname === "127.0.0.1" ||
+    url.hostname === "localhost" ||
+    url.hostname === "[::1]" ||
+    url.hostname === "::1");
+
+export const processIsAlive = (pid: number): boolean => {
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (error) {
+    return error instanceof Error && "code" in error && error.code === "EPERM";
+  }
+};
+
+const fail = (reason: string, cause?: unknown) =>
+  Effect.fail(
+    new DesktopExistingBackendAttachmentError({
+      reason,
+      ...(cause === undefined ? {} : { cause }),
+    }),
+  );
+
+export const validateRuntimeOrigin = (
+  runtime: {
+    readonly origin: string;
+    readonly port: number;
+  },
+  expectedPort?: number,
+): Effect.Effect<URL, DesktopExistingBackendAttachmentError> =>
+  Effect.try({
+    try: () => new URL(runtime.origin),
+    catch: (cause) => cause,
+  }).pipe(
+    Effect.mapError(
+      (cause) =>
+        new DesktopExistingBackendAttachmentError({
+          reason: "server origin is invalid",
+          cause,
+        }),
+    ),
+    Effect.filterOrFail(
+      isLoopback,
+      () =>
+        new DesktopExistingBackendAttachmentError({ reason: "the server origin is not loopback" }),
+    ),
+    Effect.filterOrFail(
+      (origin) => (origin.port === "" ? 80 : Number(origin.port)) === runtime.port,
+      () =>
+        new DesktopExistingBackendAttachmentError({
+          reason: "server runtime origin port does not match runtime port",
+        }),
+    ),
+    Effect.filterOrFail(
+      () => expectedPort === undefined || runtime.port === expectedPort,
+      () =>
+        new DesktopExistingBackendAttachmentError({
+          reason: `server runtime port does not match configured attachment port ${expectedPort}`,
+        }),
+    ),
+  );
+
+export interface DesktopExistingBackendAttachmentOperations {
+  readonly readFileString: (path: string) => Effect.Effect<string, unknown>;
+  readonly isProcessAlive: (pid: number) => boolean;
+  readonly fetchDescriptor: (
+    origin: URL,
+  ) => Effect.Effect<{ readonly environmentId: string; readonly label: string }, unknown>;
+  readonly issueSession: () => Effect.Effect<string, unknown>;
+}
+
+export interface DesktopExistingBackendAttachmentInput {
+  readonly enabled: boolean;
+  readonly stateDir: string;
+  readonly expectedPort?: number;
+  readonly joinPath: (first: string, second: string) => string;
+  readonly operations: DesktopExistingBackendAttachmentOperations;
+}
+
+export const makeWithOperations = (input: DesktopExistingBackendAttachmentInput) =>
+  Effect.gen(function* () {
+    const stateRef = yield* Ref.make<DesktopExistingBackendAttachmentState>({ kind: "disabled" });
+    const bootstrapMutex = yield* Semaphore.make(1);
+
+    const resolve = Effect.fn("desktop.existingBackendAttachment.resolve")(function* () {
+      const runtimeJson = yield* input.operations
+        .readFileString(input.joinPath(input.stateDir, "server-runtime.json"))
+        .pipe(
+          Effect.mapError(
+            (cause) =>
+              new DesktopExistingBackendAttachmentError({
+                reason: "server-runtime.json is missing or unreadable",
+                cause,
+              }),
+          ),
+        );
+      const runtime = yield* Schema.decodeUnknownEffect(ServerRuntimeState)(runtimeJson).pipe(
+        Effect.mapError(
+          (cause) =>
+            new DesktopExistingBackendAttachmentError({
+              reason: "server-runtime.json is corrupt",
+              cause,
+            }),
+        ),
+      );
+      if (runtime.pid <= 0) return yield* fail("server runtime pid is not positive");
+      if (!input.operations.isProcessAlive(runtime.pid))
+        return yield* fail("the server process is no longer running");
+      const origin = yield* validateRuntimeOrigin(runtime, input.expectedPort);
+      const localEnvironmentId = yield* input.operations
+        .readFileString(input.joinPath(input.stateDir, "environment-id"))
+        .pipe(
+          Effect.mapError(
+            (cause) =>
+              new DesktopExistingBackendAttachmentError({
+                reason: "environment-id is missing or unreadable",
+                cause,
+              }),
+          ),
+          Effect.map((value) => value.trim()),
+        );
+      if (localEnvironmentId.length === 0) return yield* fail("environment-id is empty");
+      const descriptor = yield* input.operations.fetchDescriptor(origin).pipe(
+        Effect.mapError(
+          (cause) =>
+            new DesktopExistingBackendAttachmentError({
+              reason: "existing server descriptor probe failed",
+              cause,
+            }),
+        ),
+      );
+      if (descriptor.environmentId !== localEnvironmentId)
+        return yield* fail("existing server environment does not match local environment-id");
+      const output = yield* input.operations.issueSession().pipe(
+        Effect.timeout(ATTACHMENT_TIMEOUT),
+        Effect.mapError(
+          (cause) =>
+            new DesktopExistingBackendAttachmentError({
