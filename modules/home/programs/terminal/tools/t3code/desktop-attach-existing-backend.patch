+            env: { ELECTRON_RUN_AS_NODE: "1" },
+            extendEnv: true,
+            stdin: "ignore",
+            stdout: "pipe",
+            stderr: "inherit",
+          },
+        );
+        return spawner.string(command);
+      },
+    },
+  });
