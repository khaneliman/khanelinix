+export function splitAntigravityPrintStreamChunk(
+  carry: string,
+  chunk: string,
+): { readonly lines: ReadonlyArray<string>; readonly carry: string } {
+  const parts = `${carry}${chunk}`.split(/\r?\n/u);
+  return {
+    lines: parts.slice(0, -1),
+    carry: parts.at(-1) ?? "",
+  };
+}
+
+export function parseAntigravityPrintStreamLine(
+  line: string,
+): AntigravityPrintStreamEvent | undefined {
+  const trimmed = line.trim();
+  if (!trimmed) return undefined;
+  try {
+    const parsed = JSON.parse(trimmed) as unknown;
+    return isAntigravityPrintStreamEvent(parsed) ? parsed : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+function subagentTaskLinkage(state: AntigravitySubagentState) {
+  return {
+    taskType: "subagent",
+    title: state.title,
+    ...(state.role ? { role: state.role } : {}),
+  } as const;
+}
+
+export function mapAntigravityPrintStreamEventToRuntimeEvents(input: {
+  readonly event: AntigravityPrintStreamEvent;
+  readonly subagents: Map<string, AntigravitySubagentState>;
+  readonly threadId: ThreadId;
+  readonly instanceId?: ProviderInstanceId;
+  readonly turnId?: TurnId;
+  readonly createdAt?: string;
+}): ReadonlyArray<ProviderRuntimeEvent> {
+  const { event, subagents, threadId, instanceId, turnId, createdAt } = input;
+  const update = event.step_update;
+  if (update?.step_type?.trim().toLowerCase() !== "subagent") return [];
+
+  const events: ProviderRuntimeEvent[] = [];
+  for (const child of update.subagent_info?.subagents ?? []) {
+    const conversationId = child.conversation_id.trim();
+    if (!conversationId) continue;
+    const existing = subagents.get(conversationId);
+    if (existing) {
+      // ACTIVE describes the current invoke_subagent step, not the child's
+      // complete lifecycle. It can safely wake an idle child. DONE cannot
+      // settle the child because Antigravity children remain resumable.
+      if (update.state?.trim().toUpperCase() === "ACTIVE" && existing.status === "idle") {
+        existing.status = "running";
+        events.push({
+          ...runtimeEventBase({
+            threadId,
+            instanceId,
+            turnId,
+            createdAt,
+            method: "agy.print.subagent",
+            rawSource: "antigravity.cli",
+            payload: event,
+          }),
+          type: "task.updated",
+          payload: {
+            taskId: RuntimeTaskId.make(conversationId),
+            status: "running",
+            ...subagentTaskLinkage(existing),
+          },
+        });
+      }
+      continue;
+    }
+    const role = trimText(child.role);
+    const typeName = trimText(child.type_name);
+    const state: AntigravitySubagentState = {
+      conversationId,
+      title: role ?? typeName ?? "Antigravity subagent",
+      role,
+      initialPrompt: trimText(child.initial_prompt),
+      status: "running",
+      lastMessageKey: undefined,
+    };
+    subagents.set(conversationId, state);
+    events.push({
+      ...runtimeEventBase({
+        threadId,
+        instanceId,
+        turnId,
+        createdAt,
+        method: "agy.print.subagent",
+        rawSource: "antigravity.cli",
+        payload: event,
+      }),
+      type: "task.started",
+      payload: {
+        taskId: RuntimeTaskId.make(conversationId),
+        ...(state.initialPrompt ? { description: state.initialPrompt } : {}),
+        ...subagentTaskLinkage(state),
+      },
+    });
+  }
+  return events;
+}
+
+function parseAntigravitySubagentMessage(content: string | undefined):
+  | {
+      readonly conversationId: string;
+      readonly summary: string;
+      readonly status: "running" | "idle";
+    }
+  | undefined {
+  if (!content) return undefined;
+  const messageMatch = content.match(
+    /^\s*<SYSTEM_MESSAGE>\s*\n\[Message\][^\n]*?\bsender=(\S+)[^\n]*?\bcontent=([\s\S]*?)\n<\/SYSTEM_MESSAGE>\s*$/u,
+  );
+  const sender = messageMatch?.[1];
+  const messageContent = messageMatch?.[2]?.trim();
+  if (!sender || !messageContent) {
+    return undefined;
+  }
+  if (sender !== "system") {
+    return { conversationId: sender, summary: messageContent, status: "running" };
+  }
+  const idleMatch = messageContent.match(
+    /^Subagent\s+(\S+)\s+has gone idle\.\s+This was the subagent's most recent response:\s*([\s\S]+)$/u,
+  );
+  if (!idleMatch?.[1] || !idleMatch[2]?.trim()) return undefined;
+  return { conversationId: idleMatch[1], summary: idleMatch[2].trim(), status: "idle" };
+}
+
+export function mapAntigravitySubagentTranscriptRecordToRuntimeEvents(input: {
+  readonly record: AntigravityTranscriptRecord;
+  readonly subagents: Map<string, AntigravitySubagentState>;
+  readonly threadId: ThreadId;
+  readonly instanceId?: ProviderInstanceId;
+  readonly turnId?: TurnId;
+  readonly createdAt?: string;
+}): ReadonlyArray<ProviderRuntimeEvent> {
+  const { record, subagents, threadId, instanceId, turnId, createdAt } = input;
+  if (
+    normalizeTranscriptType(record.source) !== "SYSTEM" ||
+    normalizeTranscriptType(record.type) !== "SYSTEM_MESSAGE"
+  ) {
+    return [];
+  }
+  const message = parseAntigravitySubagentMessage(record.content);
+  if (!message) return [];
+  const state = subagents.get(message.conversationId);
+  if (!state) return [];
+  const messageKey = `${message.status}:${message.summary}`;
+  if (state.lastMessageKey === messageKey) return [];
+  state.lastMessageKey = messageKey;
+  state.status = message.status;
+
+  return [
+    {
+      ...runtimeEventBase({
+        threadId,
+        instanceId,
+        turnId,
+        createdAt,
+        method: "transcript.subagent-message",
+        payload: record,
+      }),
+      type: "task.progress",
+      payload: {
+        taskId: RuntimeTaskId.make(state.conversationId),
+        description: state.title,
+        summary: message.summary,
+        status: message.status,
+        ...subagentTaskLinkage(state),
+      },
+    },
+  ];
+}
