From 632e39e68e7b6b54eb994687bb5a06b4f8fda49d Mon Sep 17 00:00:00 2001
From: Austin Horstman <khaneliman12@gmail.com>
Date: Wed, 9 Sep 2026 10:23:11 -0500
Subject: [PATCH] fix(tray): create dbusmenu early, fall back only without a
 layout

b58018bc (#5238) moved makeMenu() out of the Menu property handler and
into handleClick(), so the GTK menu is created and popped up in the same
block while libdbusmenu is still fetching its layout. The first right
click shows an empty menu and logs the DBUSMENU_IS_MENUITEM assertion.
Re-regression of 01ad3d96. The Version probe also broke blueman-tray,
whose menu object lacks that property and has no ContextMenu fallback.

Create the menu when the Menu property arrives again. Keep the #5238
fallback for items that never serve com.canonical.dbusmenu (Steam) by
calling ContextMenu when the dbusmenu client has no layout root.

Fixes #5285
---
 include/modules/sni/item.hpp |  4 +---
 src/modules/sni/item.cpp     | 45 +++++++++++++-----------------------
 2 files changed, 17 insertions(+), 32 deletions(-)

diff --git a/include/modules/sni/item.hpp b/include/modules/sni/item.hpp
index 3f83791f..79940b24 100644
--- a/include/modules/sni/item.hpp
+++ b/include/modules/sni/item.hpp
@@ -94,9 +94,8 @@ class Item : public sigc::trackable {
   Glib::RefPtr<Gdk::Pixbuf> getIconByName(const std::string& name, int size);
   double getScaledIconSize();
   static void onMenuDestroyed(Item* self, GObject* old_menu_pointer);
-  void validateMenu();
-  void menuProbeReady(Glib::RefPtr<Gio::AsyncResult>& result, const std::string& menu_path);
   void makeMenu();
+  bool hasMenuLayout() const;
   bool handleClick(GdkEventButton* const& /*ev*/);
   bool handleScroll(GdkEventScroll* const&);
   bool handleMouseEnter(GdkEventCrossing* const&);
@@ -120,7 +119,6 @@ class Item : public sigc::trackable {
 
   Glib::RefPtr<Gio::DBus::Proxy> proxy_;
   Glib::RefPtr<Gio::Cancellable> cancellable_;
-  bool has_dbus_menu_ = false;
   std::set<std::string_view> update_pending_;
 
   Host& host_;
diff --git a/src/modules/sni/item.cpp b/src/modules/sni/item.cpp
index 55f2d37e..065d032d 100644
--- a/src/modules/sni/item.cpp
+++ b/src/modules/sni/item.cpp
@@ -40,7 +40,6 @@ namespace waybar::modules::SNI {
 
 static const Glib::ustring SNI_INTERFACE_NAME = sn_item_interface_info()->name;
 static const unsigned UPDATE_DEBOUNCE_TIME = 10;
-static const char DBUSMENU_INTERFACE[] = "com.canonical.dbusmenu";
 
 Item::Item(const std::string& bn, const std::string& op, const Json::Value& config, const Bar& bar,
            const std::function<void(Item&)>& on_ready,
@@ -238,7 +237,9 @@ void Item::setProperty(const Glib::ustring& name, Glib::VariantBase& value) {
       }
     } else if (name == "Menu") {
       menu = get_variant<std::string>(value);
-      validateMenu();
+      // Create the menu as soon as the path is known: libdbusmenu fetches the layout
+      // asynchronously, and a menu popped up before that completes renders empty.
+      makeMenu();
     } else if (name == "ItemIsMenu") {
       item_is_menu = get_variant<bool>(value);
     }
@@ -572,33 +573,8 @@ void Item::onMenuDestroyed(Item* self, GObject* old_menu_pointer) {
   }
 }
 
-void Item::validateMenu() {
-  has_dbus_menu_ = false;
-  if (menu.empty() || !proxy_) {
-    return;
-  }
-
-  auto parameters =
-      Glib::VariantContainerBase(g_variant_new("(ss)", DBUSMENU_INTERFACE, "Version"));
-  proxy_->get_connection()->call(menu, "org.freedesktop.DBus.Properties", "Get", parameters,
-                                 sigc::bind(sigc::mem_fun(*this, &Item::menuProbeReady), menu),
-                                 cancellable_, bus_name);
-}
-
-void Item::menuProbeReady(Glib::RefPtr<Gio::AsyncResult>& result, const std::string& menu_path) {
-  if (menu != menu_path) {
-    return;
-  }
-
-  try {
-    proxy_->get_connection()->call_finish(result);
-    has_dbus_menu_ = true;
-  } catch (const Glib::Error&) {
-  }
-}
-
 void Item::makeMenu() {
-  if (gtk_menu == nullptr && has_dbus_menu_) {
+  if (gtk_menu == nullptr && !menu.empty()) {
     dbus_menu = dbusmenu_gtkmenu_new(bus_name.data(), menu.data());
     if (dbus_menu != nullptr) {
       g_object_ref_sink(G_OBJECT(dbus_menu));
@@ -621,6 +597,14 @@ void Item::makeMenu() {
   event_box.unset_state_flags(Gtk::StateFlags::STATE_FLAG_PRELIGHT);
 }
 
+bool Item::hasMenuLayout() const {
+  if (dbus_menu == nullptr) {
+    return false;
+  }
+  DbusmenuGtkClient* client = dbusmenu_gtkmenu_get_client(dbus_menu);
+  return client != nullptr && dbusmenu_client_get_root(DBUSMENU_CLIENT(client)) != nullptr;
+}
+
 bool Item::handleClick(GdkEventButton* const& ev) {
   if (!proxy_) {
     return false;
@@ -630,7 +614,10 @@ bool Item::handleClick(GdkEventButton* const& ev) {
        Glib::Variant<int>::create(ev->y_root + bar_.y_global)});
   if ((ev->button == 1 && item_is_menu) || ev->button == 3) {
     makeMenu();
-    if (gtk_menu != nullptr) {
+    // Some items advertise a Menu path without serving com.canonical.dbusmenu (e.g. Steam), so
+    // the client never gets a layout root. Use the item's own ContextMenu for those instead of
+    // popping up an empty GTK menu.
+    if (gtk_menu != nullptr && hasMenuLayout()) {
 #if GTK_CHECK_VERSION(3, 22, 0)
       gtk_menu->popup_at_pointer(reinterpret_cast<GdkEvent*>(ev));
 #else
-- 
2.55.0

