configuration {
    font: "MonaspaceNeon NF 14";
	show-icons: true;
	drun-display-format: "{name}";
    icon-theme: "Papirus-Dark";
	fullscreen: false;
	threads: 0;
	matching: "fuzzy";
	scroll-method: 0;
	disable-history: false;
	fullscreen: false;
	window-thumbnail: true;
}

@theme "khanelinix-palette"

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 360px;
    width: 33%;
    border: 3px;
    border-radius:6px;
    background-color: @background;
    border-color:@accent;
}

mainbox {
    background-color: @background;
}

inputbar {
    children: [prompt,entry];
    background-color: @background;
    border-radius: 6px;
    padding: 2px;
}

prompt {
    background-color: @accent;
    padding: 6px;
    text-color: @accentForeground;
    border-radius: 6px;
    margin: 20px 0px 0px 20px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 6px;
    margin: 20px 10px 0px 10px;
    text-color: @foreground;
    background-color: @background;
    border: 2px;
    border-radius: 3px;
    border-color: @accent;
    placeholder:"Search";

}

listview {
    border: 0px 0px 0px;
    padding: 6px 0px 0px;
    margin: 10px 0px 0px 20px;
    columns: 2;
    background-color: @background;
}

element {
    padding: 5px;
    background-color: @background;
    text-color: @foreground  ;
}

element-icon {
    size: 25px;
}

element selected {
    background-color:  @accent ;
    text-color: @accentForeground  ;
}

mode-switcher {
    spacing: 0;
  }

button {
    padding: 10px;
    background-color: @surface;
    text-color: @muted;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
  background-color: @background;
  text-color: @accent;
}
